# Immich API access for immich-auto-tag
#
# Required API key scopes (Account Settings -> API Keys when creating):
#   asset.read, tag.create, tag.read, tag.asset

API_URL=http://immich.example.com/api
API_KEY=your_api_key_here

ROOT_PATH=/mnt/photos

# How many folder levels below ROOT_PATH become tags.
# 1 = only the top folder. 2 = top folder + one sub-level.
TAG_LEVELS=2

# Optional: one regex per level. A folder on that level is only included
# in the tag hierarchy if it matches; if it doesn't, the hierarchy stops
# at the previous level (deeper levels are never included) for that asset.
# Example: only include year-looking folders on level 2, skip month
# folders below them entirely:
TAG_LEVEL_2_REGEX=^\d{4}$

# Colon-separated literals or glob patterns (supporting * ? [] and **) to
# exclude matching assets entirely.
IGNORE=

# Colon-separated literals or glob patterns: if set, ONLY matching assets
# are considered.
PATH_FILTER=

# Dry run: log what would happen without writing anything (true/false)
DRY_RUN=true

LOG_LEVEL=INFO
CHUNK_SIZE=50
PAGE_SIZE=1000
